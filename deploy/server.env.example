SYNC_BIND=127.0.0.1:8790
SYNC_PUBLIC_BASE_URL=https://sync.example.invalid
SYNC_DATA_DIR=/var/lib/syncserver
# 可选：仅没有注册账户的旧单账户模式需要；账户部署省略本行并删除该 0600 文件
# SYNC_API_KEY_FILE=/etc/syncserver/api.key
SYNC_SIGNING_KEY_FILE=/etc/syncserver/signing.key
SYNC_CONTAINER=com.apple.photos.cloud
SYNC_ZONES=PrimarySync
# 每用户云端逻辑资源总额：20 GB（十进制字节）；原图和缩略图均计入
SYNC_USER_STORAGE_QUOTA_BYTES=20000000000
SYNC_LEASE_TTL_SECS=90
SYNC_LEASE_HEARTBEAT_SECS=30
SYNC_CONTROL_QUEUE_CAPACITY=16
SYNC_LOG_LEVEL=info
SYNC_LOG_PERSIST_LEVEL=info
SYNC_LOG_FORMAT=json
SYNC_LOG_PAYLOAD=off
SYNC_LOG_RETENTION_RAW_SECS=86400
SYNC_LOG_ARCHIVE_MAX_BYTES=1073741824
SYNC_UPLOAD_CONCURRENCY=2
SYNC_DOWNLOAD_CONCURRENCY=8
SYNC_UPLOAD_IDLE_TIMEOUT_SECS=30
SYNC_UPLOAD_TOTAL_TIMEOUT_SECS=3600
